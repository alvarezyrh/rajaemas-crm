# --- Server -----------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# node:cluster worker count: a number or "auto" (= CPU cores)
CLUSTER_WORKERS=1
# true when running behind a reverse proxy / load balancer (X-Forwarded-For)
TRUST_PROXY=false

# --- Penyimpanan -------------------------------------------------------
DATABASE_URL=postgres://rajaemas:rajaemas@localhost:5432/rajaemas_crm
# Leave empty for the in-memory cache (single process / development only)
REDIS_URL=redis://localhost:6379

# --- Cryptographic keys (generate with: npm run keys) ------------------
# In production keep them in a secret manager, separate from the database.
PII_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
TOKEN_SECRET=
WEBHOOK_SECRET=
TOKEN_TTL_SEC=28800

# --- Operasional -------------------------------------------------------
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10
APPOINTMENT_SLOT_CAPACITY=3

# --- Bonus staf & Loyal Customer ---------------------------------------
# ANGKA SEMENTARA: aturan bisnisnya belum dikonfirmasi. Defaultnya ada di
# src/shared/bonus.js dan src/shared/loyalty.js; buka komentarnya untuk mengganti.
# BONUS_BUY_PERCENT=0.10      # % dari nilai transaksi saat nasabah membeli emas
# BONUS_SELL_PERCENT=0.25     # % dari nilai transaksi saat buyback
# BONUS_CAP_IDR=500000        # plafon per transaksi
# BONUS_ROUND_TO=100          # dibulatkan ke bawah ke satuan ini
# LOYAL_MIN_TRANSACTIONS=3    # minimal transaksi dalam jendela
# LOYAL_MIN_AMOUNT=10000000   # minimal total nilai dalam jendela
# LOYAL_WINDOW_DAYS=365
# LOYAL_TIERS=GOLD,PLATINUM   # tier ini otomatis dianggap loyal

# --- Seed (pengembangan saja) ------------------------------------------
SEED_PASSWORD=

# Partner API sync (menu "API"). Private/internal hosts and plain http are refused in
# production unless set to true. Defaults to allowed outside production (local mocks).
# INTEGRATION_ALLOW_PRIVATE_HOSTS=false

# --- Google Reviews on-demand & Meta WhatsApp Cloud API ----------------
# Reviews are fetched only on request for a selected outlet; review content is not stored.
# GOOGLE_PLACES_API_KEY=
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_API_VERSION=v24.0
